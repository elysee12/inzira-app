generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int       @id @default(autoincrement())
  email            String    @unique
  phone            String    @unique
  password         String
  name             String
  role             Role      @default(PARENT)
  otpCode          String?
  otpExpires       DateTime?
  province         String?
  district         String?
  sector           String?
  cell             String?
  village          String?
  assignedCHWId    Int?
  assignedCHW      User?     @relation("CHWParents", fields: [assignedCHWId], references: [id], onDelete: SetNull)
  assignedParents  User[]    @relation("CHWParents")
  facilityId       Int?
  facility         Facility? @relation(fields: [facilityId], references: [id], onDelete: SetNull)
  sentMessages     Message[] @relation("SentMessages")
  receivedMessages Message[] @relation("ReceivedMessages")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  contents         Content[]
}

enum Role {
  ADMIN
  PARENT
  CHW
  NURSE
}

model Facility {
  id          Int      @id @default(autoincrement())
  name        String
  type        String   // Hospital, Health Center, Clinic, etc.
  province    String?
  district    String?
  sector      String?
  phone       String?
  email       String?
  description String?  @db.Text
  isActive    Boolean  @default(true)
  users       User[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Message {
  id         Int      @id @default(autoincrement())
  senderId   Int
  sender     User     @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId Int
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  content    String   @db.Text
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([senderId, receiverId])
  @@index([receiverId, isRead])
}

model AgeCategory {
  id          String    @id
  label       String
  sublabel    String
  color       String
  bgColor     String
  iconName    String
  description String    @db.Text
  imageUrl    String?   @db.Text
  contents    Content[]
}

model Content {
  id            Int         @id @default(autoincrement())
  title         String
  description   String      @db.Text
  type          ContentType
  duration      String?
  fileUrl       String?     @db.Text
  textContent   String?     @db.LongText
  ageGroup      String
  ageCategory   AgeCategory @relation(fields: [ageGroup], references: [id])
  postedById    Int
  postedBy      User        @relation(fields: [postedById], references: [id])
  postedAt      DateTime    @default(now())
  isNew         Boolean     @default(true)
}

enum ContentType {
  text
  audio
  video
}
