{
  "expo": {
    "name": "Imirire - Uburezi bw'Umwana",
    "slug": "imirire-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "imirire-app",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/splash.png",
      "resizeMode": "cover",
      "backgroundColor": "#1A8A3A"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "rw.imirire.app",
      "versionCode": 1
    },
    "web": {
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://replit.com/"
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "edd6c93c-8a01-464e-b5f7-2c0d66060d2b"
      }
    }
  }
}
